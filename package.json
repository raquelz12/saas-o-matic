{
  "name": "saas-o-matic",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend \"npm run dev -w backend --if-present\" \"npm run dev -w frontend\"",
    "lint": "eslint . && prettier --check \"**/*.{ts,tsx,js,jsx,css}\"",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
