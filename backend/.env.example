# Copia este archivo como .env para cambiar los valores por defecto (RNF-02).

# Puerto del backend (spec 4.7).
PORT=3000

# Interfaz de escucha. Por defecto solo local: no hay autenticación (RNF-03).
HOST=127.0.0.1

# Ruta del archivo SQLite, relativa a backend/.
DB_PATH=./data/saas-o-matic.db

# Origen permitido por CORS: el servidor de desarrollo de Vite (spec 5.1).
CORS_ORIGIN=http://localhost:5173
